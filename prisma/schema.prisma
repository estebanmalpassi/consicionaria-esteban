// Concesionaria Esteban — Marketplace & Dealer SaaS (Argentina)
// Prisma schema: identity/KYC, inventory, legal-document verification, buyer discovery, billing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

enum Role {
  BUYER
  DEALER_OWNER
  DEALER_STAFF
  ADMIN
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  phone         String?
  avatarUrl     String?
  role          Role     @default(BUYER)
  emailVerified DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // A staff/owner user belongs to at most one dealership.
  dealershipId String?
  dealership   Dealership? @relation("DealershipStaff", fields: [dealershipId], references: [id])

  ownedDealership Dealership? @relation("DealershipOwner")

  savedListings SavedListing[]
  swipeActions  SwipeAction[]
  reviewedDocs  DealershipDocument[] @relation("DocumentReviewer")
  auditLogs     AuditLog[]

  @@index([dealershipId])
}

// ---------------------------------------------------------------------------
// Dealership onboarding & KYC
// ---------------------------------------------------------------------------

enum DealershipStatus {
  PENDING          // registered, nothing submitted yet
  DOCS_SUBMITTED   // CUIT + docs uploaded, awaiting AFIP/automated checks
  IN_REVIEW        // admin manual review
  VERIFIED         // can publish listings
  REJECTED
  SUSPENDED        // previously verified, access revoked (fraud, disputes)
}

model Dealership {
  id            String           @id @default(cuid())
  legalName     String
  tradeName     String
  cuit          String           @unique // Argentine tax ID, validated on submit
  status        DealershipStatus @default(PENDING)

  // AFIP / fiscal
  afipConditionIva String?       // e.g. "Responsable Inscripto", "Monotributo"
  afipCredentialId String?       // reference to encrypted-at-rest credential store, never raw secrets

  addressStreet String?
  addressCity   String?
  province      String?
  postalCode    String?
  phone         String?
  website       String?

  // Datos para comprobantes (factura, recibos, boleto)
  pointOfSale       Int     @default(1) // punto de venta AFIP
  grossIncomeNumber String? // Nº de Ingresos Brutos
  activityStartDate String? // inicio de actividades (texto libre, ej. "01/03/2015")

  ownerId String  @unique
  owner   User    @relation("DealershipOwner", fields: [ownerId], references: [id])
  staff   User[]  @relation("DealershipStaff")

  documents     DealershipDocument[]
  vehicles      Vehicle[]
  subscription  Subscription?
  invoices      Invoice[]
  auditLogs     AuditLog[]
  customers     Customer[]
  sales         Sale[]

  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
}

enum DealershipDocumentType {
  CUIT_CONSTANCIA        // AFIP "Constancia de Inscripción"
  AFIP_CREDENTIALS        // clave fiscal delegation / WSAA certificate reference
  LEGAL_ID                // DNI of the legal representative
  BUSINESS_LICENSE        // habilitación municipal / comercial
  POWER_OF_ATTORNEY       // poder, when representative != owner
}

enum DocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model DealershipDocument {
  id           String                 @id @default(cuid())
  dealershipId String
  dealership   Dealership             @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  type         DealershipDocumentType
  fileUrl      String
  status       DocumentReviewStatus   @default(PENDING)

  reviewedById String?
  reviewedBy   User?                  @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  reviewNotes  String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealershipId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Vehicle inventory
// ---------------------------------------------------------------------------

enum VehicleStatus {
  DRAFT                 // photos + patente entered, verification not started
  PENDING_VERIFICATION  // verification checks running
  PUBLISHED             // all mandatory docs verified, visible to buyers
  PAUSED                // temporarily hidden by dealer
  SOLD
  REJECTED              // failed verification / fraud flag
}

enum FuelType {
  NAFTA
  DIESEL
  GNC
  HIBRIDO
  ELECTRICO
}

enum TransmissionType {
  MANUAL
  AUTOMATICA
}

model Vehicle {
  id           String   @id @default(cuid())
  dealershipId String
  dealership   Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  patente   String @unique // license plate, primary lookup key for auto-verification
  vin       String?

  brand       String
  model       String
  version     String?
  year        Int
  mileageKm   Int
  priceArs    Decimal          @db.Decimal(14, 2)
  fuelType    FuelType         @default(NAFTA)
  transmission TransmissionType @default(MANUAL)
  color       String?
  description String?
  bodyType     String? // sedán, hatchback, pick-up, SUV...
  engineNumber String? // número de motor (necesario para el 08 y el boleto)
  purchasePriceArs Decimal? @db.Decimal(14, 2) // costo de compra, para ver el margen (uso interno)

  city     String?
  province String?

  status      VehicleStatus @default(DRAFT)
  publishedAt DateTime?

  photos        VehiclePhoto[]
  verifications VehicleVerification[]
  savedBy       SavedListing[]
  swipeActions  SwipeAction[]
  invoices      Invoice[]
  sales         Sale[]
  expenses      VehicleExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealershipId])
  @@index([status])
  @@index([brand, model])
  @@index([priceArs])
}

/// Gastos que la agencia le hizo al auto (chapa, cubiertas, service, VTV...).
/// Uso interno: no se muestran en la web ni salen en boletos o recibos.
model VehicleExpense {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  category    String
  description String?
  amountArs   Decimal  @db.Decimal(14, 2)
  date        DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([vehicleId])
}

model VehiclePhoto {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  url      String? // URL externa (storage futuro); si es null la foto está en `data`
  data     Bytes?  // JPEG comprimido en el navegador antes de subir
  mimeType String?
  label    String? // "Frente", "Interior", "Tablero"...
  order    Int     @default(0)
  isCover  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([vehicleId])
}

// ---------------------------------------------------------------------------
// Legal-document auto-verification (the platform's core trust mechanism)
// ---------------------------------------------------------------------------

enum VerificationDocType {
  FORMULARIO_08      // transfer form, signed status
  TITULO_PROPIEDAD   // título de propiedad automotor
  TARJETA_VERDE      // green card / cédula
  LIBRE_DEUDA        // infracciones y patentes al día
  INFORME_DOMINIO    // domain/lien/ownership report
}

enum VerificationStatus {
  PENDING
  IN_PROGRESS
  VERIFIED
  FAILED
  EXPIRED
}

model VehicleVerification {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  docType VerificationDocType
  status  VerificationStatus  @default(PENDING)

  provider     String?  // e.g. "DNRPA", "AFIP", "Rentas Provinciales"
  externalRef  String?  // ticket/reference id from the provider integration
  resultPayload Json?   // raw normalized response, for audit/debugging

  verifiedAt DateTime?
  expiresAt  DateTime? // e.g. libre de deuda has a validity window

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vehicleId, docType])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Buyer discovery
// ---------------------------------------------------------------------------

enum SwipeActionType {
  SAVE
  PASS
}

model SwipeAction {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  action    SwipeActionType
  createdAt DateTime        @default(now())

  @@unique([userId, vehicleId])
  @@index([userId])
}

model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, vehicleId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Billing: subscriptions, invoicing, AFIP electronic invoicing
// ---------------------------------------------------------------------------

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum PaymentProvider {
  MERCADO_PAGO
  STRIPE
}

model Subscription {
  id           String             @id @default(cuid())
  dealershipId String             @unique
  dealership   Dealership         @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  plan   SubscriptionPlan   @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  provider         PaymentProvider?
  externalId       String? // subscription/customer id at the gateway
  listingsQuota    Int             @default(3)
  currentPeriodEnd DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum InvoiceType {
  FACTURA_A
  FACTURA_B
  FACTURA_C
}

enum InvoiceStatus {
  PENDING
  ISSUED
  FAILED
  CANCELED
}

model Invoice {
  id           String     @id @default(cuid())
  dealershipId String
  dealership   Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  vehicleId    String?
  vehicle      Vehicle?   @relation(fields: [vehicleId], references: [id])

  type     InvoiceType
  provider PaymentProvider
  status   InvoiceStatus @default(PENDING)

  amountArs Decimal @db.Decimal(14, 2)
  afipCae   String? // Código de Autorización Electrónico once issued
  pdfUrl    String?

  issuedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([dealershipId])
}

// ---------------------------------------------------------------------------
// Ventas: clientes, operación y carpeta de documentación
// ---------------------------------------------------------------------------

enum IvaCondition {
  CONSUMIDOR_FINAL
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
}

// Persona que interviene en una operación: comprador o vendedor particular.
model Customer {
  id           String     @id @default(cuid())
  dealershipId String
  dealership   Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  fullName      String
  docType       String       @default("DNI") // DNI, CUIT, CUIL, Pasaporte
  docNumber     String
  ivaCondition  IvaCondition @default(CONSUMIDOR_FINAL)
  nationality   String?
  maritalStatus String?
  birthDate     String?
  occupation    String?
  address       String?
  city          String?
  province      String?
  postalCode    String?
  phone         String?
  email         String?

  purchases     Sale[] @relation("SaleBuyer")
  salesAsSeller Sale[] @relation("SaleSeller")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dealershipId, docNumber])
  @@index([dealershipId])
}

enum SaleStatus {
  RESERVADA  // se tomó una seña
  VENDIDA    // operación cerrada, falta entregar
  ENTREGADA  // auto entregado
  ANULADA
}

enum PaymentMethod {
  CONTADO
  TRANSFERENCIA
  FINANCIADO
  PERMUTA
  MIXTO
}

model Sale {
  id           String     @id @default(cuid())
  dealershipId String
  dealership   Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  number       Int        // número de operación correlativo por concesionaria

  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  buyerId  String
  buyer    Customer  @relation("SaleBuyer", fields: [buyerId], references: [id])
  // null = vende la propia concesionaria; si no, un particular (consignación / intermediación)
  sellerId String?
  seller   Customer? @relation("SaleSeller", fields: [sellerId], references: [id])

  status        SaleStatus    @default(VENDIDA)
  saleDate      DateTime      @default(now())
  priceArs      Decimal       @db.Decimal(14, 2)
  depositArs    Decimal       @default(0) @db.Decimal(14, 2) // seña / pago a cuenta
  paymentMethod PaymentMethod @default(CONTADO)
  paymentNotes  String?

  // Permuta: el cliente entrega un usado como parte de pago
  tradeInDescription String?
  tradeInPatente     String?
  tradeInValueArs    Decimal? @db.Decimal(14, 2)

  deliveryDate DateTime?
  deliveryKm   Int?

  // Cláusula 5ª del boleto: quién paga la transferencia y en cuántos días se hace
  transferCostsBy String? // "COMPRADOR" | "VENDEDOR" | "AMBOS"
  transferDays    Int?

  // Comprobante fiscal
  invoiceType   InvoiceType?
  ivaRate       Decimal      @default(21) @db.Decimal(5, 2)
  invoiceNumber Int?
  afipCae       String?
  afipCaeExpiry String?

  checklist Json?   // { [paso]: true } — trámites de transferencia completados
  notes     String?   // cláusulas o aclaraciones que se imprimen en el boleto

  receipts Receipt[]

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dealershipId, number])
  @@index([dealershipId])
  @@index([vehicleId])
  @@index([buyerId])
}

// Recibo por cada pago de la operación (seña, saldo, cuota...)
model Receipt {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  number    Int      // correlativo por concesionaria
  date      DateTime @default(now())
  amountArs Decimal  @db.Decimal(14, 2)
  concept   String   // "Seña", "Saldo de precio", "Pago total"...
  method    PaymentMethod @default(CONTADO)
  notes     String?

  createdAt DateTime @default(now())

  @@index([saleId])
}

// ---------------------------------------------------------------------------
// Fraud prevention & audit trail
// ---------------------------------------------------------------------------

model AuditLog {
  id           String      @id @default(cuid())
  actorUserId  String?
  actor        User?       @relation(fields: [actorUserId], references: [id])
  dealershipId String?
  dealership   Dealership? @relation(fields: [dealershipId], references: [id])

  action     String // e.g. "dealership.status_changed", "vehicle.published"
  entityType String // e.g. "Vehicle", "Dealership", "VehicleVerification"
  entityId   String
  metadata   Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([dealershipId])
  @@index([entityType, entityId])
}
